+        hs->config->force_padding_len == SIZE_MAX) {
+      // Only when BoringSSL decides padding itself; a preset that states its
+      // own padding must get exactly that.
       padding_len = 1;
       // The addition of the padding extension may push us into the F5 bug.
       header_len += 4 + padding_len;
@@ -4114,7 +4151,21 @@ bool ssl_add_clienthello_tlsext(SSL_HANDSHAKE *hs, CBB *out, CBB *out_encoded,
     //
     // NB: because this code works out the length of all existing extensions
