-    if (header_len > 0xff && header_len < 0x200) {
+    bool emit_padding = false;
+    if (hs->config->force_padding_len != SIZE_MAX - 1) {
+      // Legacy emulation. |force_padding_len| holds the captured payload
+      // length; SIZE_MAX - 1 means the capture had no padding extension at
+      // all. Zero is a legal length (an empty padding extension).
+      if (hs->config->force_padding_len == SIZE_MAX) {
+        // Not overridden: fall through to BoringSSL's own rule below.
+        ;
+      } else {
+        padding_len = hs->config->force_padding_len;
+        emit_padding = true;
+      }
+    }
+    if (!emit_padding && hs->config->force_padding_len == SIZE_MAX &&
+        header_len > 0xff && header_len < 0x200) {
       // If our calculations already included a padding extension, remove that
       // factor because we're about to change its length.
       if (padding_len != 0) {
@@ -4132,7 +4183,11 @@ bool ssl_add_clienthello_tlsext(SSL_HANDSHAKE *hs, CBB *out, CBB *out_encoded,
       }
     }
 
-    if (padding_len != 0 &&
+    // Emit when the preset asked for it (|emit_padding|, where zero is a
+    // legal payload length), or when BoringSSL's own rule above produced a
+    // length.
+    if ((emit_padding || (hs->config->force_padding_len == SIZE_MAX &&
+                          padding_len != 0)) &&
         !add_padding_extension(&extensions, TLSEXT_TYPE_padding, padding_len)) {
       return false;
     }
