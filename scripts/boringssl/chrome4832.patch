diff --git a/ssl/internal.h b/ssl/internal.h
index c80e565..66e3dd9 100644
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -3374,6 +3374,17 @@ struct SSL_CONFIG {
   // that we'll accept Channel IDs from clients. It is ignored on the client.
   bool channel_id_enabled : 1;
 
+  // channel_id_offer sends the deprecated ChannelID extension (30032) with an
+  // empty payload, which is what Chrome 58-70 did.
+  bool channel_id_offer : 1;
+
+  // force_padding_len mirrors SSL_CTX's value; SIZE_MAX disables it.
+  size_t force_padding_len;
+
+  // grease_skip_ciphers mirrors SSL_CTX's value: keep GREASE out of the
+  // cipher list while the other lists still carry it.
+  bool grease_skip_ciphers : 1;
+
   // If enforce_rsa_key_usage is true, the handshake will fail if the
   // keyUsage extension is present and incompatible with the TLS usage.
   // This field is not read until after certificate verification.
@@ -4043,9 +4054,27 @@ struct ssl_ctx_st : public bssl::RefCounted<ssl_ctx_st> {
   // advertise support.
   bool channel_id_enabled : 1;
 
+  // channel_id_offer asks ClientHellos for the empty ChannelID extension used
+  // by Chrome 58-70.
+  bool channel_id_offer : 1;
+
   // grease_enabled is whether GREASE (RFC 8701) is enabled.
   bool grease_enabled : 1;
 
+  // grease_suppress_lists names lists GREASE must skip even when
+  // `grease_enabled` is on. A capture may grease one list and not another
+  // (Nike's Android app greases only the key share), which the single switch
+  // cannot express.
+  bool grease_skip_ciphers : 1;
+
+  // force_padding_len sends the RFC 7685 padding extension with exactly this
+  // payload length, regardless of the ClientHello size. `SIZE_MAX` disables it.
+  size_t force_padding_len;
+
+  // server_padding_request is the value sent in Chromium's server padding
+  // request extension (4832). A negative value disables the extension.
+  int16_t server_padding_request;
+
   // permute_extensions is whether to permute extensions when sending messages.
   bool permute_extensions : 1;
 
