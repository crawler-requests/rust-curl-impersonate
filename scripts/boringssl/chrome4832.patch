 // kExtensions contains all the supported extensions.
+// Chromium's server padding request extension (4832). Chrome sends it with
+// payload 0 to ask the server to pad its response. It is not a standard TLS
+// extension and upstream BoringSSL does not implement it.
+static bool ext_server_padding_add_clienthello(const SSL_HANDSHAKE *hs,
+                                               CBB *out, CBB *out_compressible,
+                                               ssl_client_hello_type_t type) {
+  if (type == ssl_client_hello_inner) {
+    return true;
+  }
+  const int16_t value = hs->ssl->ctx->server_padding_request;
+  if (value < 0) {
+    return true;
+  }
+  CBB contents;
+  return CBB_add_u16(out, 4832) &&
+         CBB_add_u16_length_prefixed(out, &contents) &&
+         CBB_add_u16(&contents, (uint16_t)value) && CBB_flush(out);
+}
