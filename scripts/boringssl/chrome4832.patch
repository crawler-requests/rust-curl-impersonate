diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index dd81949..1b72e49 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5267,6 +5267,23 @@ OPENSSL_EXPORT void SSL_CTX_set_retain_only_sha256_of_client_certs(SSL_CTX *ctx,
 // GREASE. See RFC 8701.
 OPENSSL_EXPORT void SSL_CTX_set_grease_enabled(SSL_CTX *ctx, int enabled);
 
+// SSL_CTX_set_grease_skip_ciphers keeps GREASE out of the cipher list while
+// leaving it in the other lists. Some clients grease only the key share.
+OPENSSL_EXPORT void SSL_CTX_set_grease_skip_ciphers(SSL_CTX *ctx, int skip);
+
+// SSL_CTX_set_server_padding_request configures the value sent in Chromium's
+// server padding request extension (4832). A negative |value| disables the
+// extension; 0..65535 is sent verbatim as the extension's u16 payload.
+OPENSSL_EXPORT void SSL_CTX_set_server_padding_request(SSL_CTX *ctx, int value);
+
+// SSL_CTX_set_channel_id_offer makes ClientHellos carry the deprecated
+// ChannelID extension (30032) with an empty payload.
+OPENSSL_EXPORT void SSL_CTX_set_channel_id_offer(SSL_CTX *ctx, int enabled);
+
+// SSL_CTX_set_force_padding_len sends the padding extension (21) with exactly
+// |len| bytes, whatever the ClientHello size. Pass SIZE_MAX to disable.
+OPENSSL_EXPORT void SSL_CTX_set_force_padding_len(SSL_CTX *ctx, size_t len);
+
 // SSL_CTX_set_permute_extensions configures whether sockets on |ctx| should
 // permute extensions. For now, this is only implemented for the ClientHello.
 OPENSSL_EXPORT void SSL_CTX_set_permute_extensions(SSL_CTX *ctx, int enabled);
